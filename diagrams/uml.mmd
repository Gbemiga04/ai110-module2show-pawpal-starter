classDiagram
    class Task {
        +String description
        +Time time
        +String frequency
        +int durationMinutes
        +String priority
        +Date dueDate
        +boolean completed
        +markComplete() void
        +markPending() void
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +addTask(task: Task) void
        +removeTask(task: Task) void
        +getTasks() List~Task~
    }

    class Owner {
        +String name
        +List~Pet~ pets
        +addPet(pet: Pet) void
        +removePet(pet: Pet) void
        +getAllTasks() List~Task~
        +saveToJson(path: Path) void
        +loadFromJson(path: Path) Owner
    }

    class Scheduler {
        +Owner owner
        +getAllTasks() List~Task~
        +getPendingTasks() List~Task~
        +getCompletedTasks() List~Task~
        +getTasksForPet(pet: Pet) List~Task~
        +sortByTime(includeCompleted: boolean) List~Task~
        +filterTasks(completed: boolean, petName: String) List~Task~
        +organizeTasks(includeCompleted: boolean) List~(Pet, Task)~
        +findNextAvailableSlot(durationMinutes: int, onDate: Date, startTime: Time, endTime: Time) Time
        +detectConflicts(onDate: Date) List~String~
        +markTaskCompleted(task: Task, today: Date) Task
        +markTaskPending(task: Task) void
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has care tasks
    Scheduler --> Owner : retrieves tasks from
    Scheduler ..> Pet : filters and organizes by pet
    Scheduler ..> Task : sorts, schedules, checks, and updates
